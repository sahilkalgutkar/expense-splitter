# Host port the compose Postgres publishes. 5433 rather than 5432 already, to
# stay out of the way of a system Postgres -- but it collides just as easily
# with another project that made the same choice, so it is overridable.
#
# Whatever you set here, backend/.env's DATABASE_URL has to name the same port.
#   POSTGRES_HOST_PORT=5434 docker compose up -d
#   # then in backend/.env:
#   DATABASE_URL="postgresql://expense:expense@localhost:5434/expense_splitter?schema=public"

POSTGRES_HOST_PORT=5433
