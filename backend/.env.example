# Local dev: matches docker-compose.yml. Production: your Neon (or other Postgres) connection string.
DATABASE_URL="postgresql://expense:expense@localhost:5433/expense_splitter?schema=public"

# Generate real random secrets for production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Get a key at https://resend.com — leave blank in dev to log invite links to the console instead of emailing them.
RESEND_API_KEY=""
INVITE_FROM_EMAIL="invites@example.com"

# URL of the deployed frontend (used for CORS and invite links)
FRONTEND_URL="http://localhost:5173"

PORT=3000
