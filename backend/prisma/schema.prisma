// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  OWNER
  MEMBER
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

enum Cadence {
  WEEKLY
  MONTHLY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  groupMemberships  GroupMember[]
  createdGroups     Group[]            @relation("GroupCreatedBy")
  paidExpenses      Expense[]          @relation("ExpensePaidBy")
  createdExpenses   Expense[]          @relation("ExpenseCreatedBy")
  expenseSplits     ExpenseSplit[]
  sentSettlements   Settlement[]       @relation("SettlementFrom")
  receivedSettlements Settlement[]     @relation("SettlementTo")
  sentInvites       Invite[]           @relation("InviteInvitedBy")
  refreshTokens     RefreshToken[]
  recurringExpenses     RecurringExpense[] @relation("RecurringCreatedBy")
  recurringExpensesPaid RecurringExpense[] @relation("RecurringPaidBy")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Group {
  id            String   @id @default(uuid())
  name          String
  createdById   String
  createdBy     User     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  members           GroupMember[]
  expenses          Expense[]
  settlements       Settlement[]
  invites           Invite[]
  recurringExpenses RecurringExpense[]
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
}

model Expense {
  id                  String    @id @default(uuid())
  groupId             String
  group               Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidById            String
  paidBy              User      @relation("ExpensePaidBy", fields: [paidById], references: [id])
  description         String
  amountCents         Int
  currency            String    @default("USD")
  category            String?
  date                DateTime  @default(now())
  createdById         String
  createdBy           User      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  recurringExpenseId  String?
  recurringExpense    RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdAt           DateTime  @default(now())

  splits ExpenseSplit[]

  @@index([groupId])
}

model ExpenseSplit {
  id         String  @id @default(uuid())
  expenseId  String
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  shareCents Int

  @@unique([expenseId, userId])
}

model RecurringExpense {
  id           String    @id @default(uuid())
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description  String
  amountCents  Int
  paidById     String
  paidBy       User      @relation("RecurringPaidBy", fields: [paidById], references: [id])
  splitType    SplitType @default(EQUAL)
  /// Either { participantUserIds: string[] } for EQUAL splits, or { splits: { userId, value }[] } for EXACT/PERCENTAGE.
  splitConfig  Json
  cadence      Cadence
  nextRunAt    DateTime
  active       Boolean   @default(true)
  createdById  String
  createdBy    User      @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  expenses Expense[]

  @@index([groupId])
  @@index([active, nextRunAt])
}

model Settlement {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User     @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User     @relation("SettlementTo", fields: [toUserId], references: [id])
  amountCents Int
  note        String?
  settledAt   DateTime @default(now())

  @@index([groupId])
}

model Invite {
  id           String       @id @default(uuid())
  groupId      String
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email        String
  token        String       @unique
  invitedById  String
  invitedBy    User         @relation("InviteInvitedBy", fields: [invitedById], references: [id])
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  @@index([groupId])
  @@index([email])
}
